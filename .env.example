SP_API_CLIENT_ID=
SP_API_CLIENT_SECRET=
SP_API_REFRESH_TOKEN=
# Modes: mock (fixtures), research (live web, no SP-API key), live (SP-API + web).
# If unset: live with complete SP-API credentials, otherwise research.
SCOUT_MODE=research

# Optional structured research providers (never required).
SERPAPI_API_KEY=
SERPAPI_CACHE_TTL_HOURS=8
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_MODE=disabled
DATAFORSEO_ALLOW_PAID=false
DATAFORSEO_MAX_COST_USD_PER_RUN=0.25
DATAFORSEO_MAX_TASKS_PER_RUN=10
DATAFORSEO_V14B_MAX_COST_USD=0.20
DATAFORSEO_V14B_MAX_TASKS=12
DATAFORSEO_V14B_COVERAGE_MAX_TASKS=1
DATAFORSEO_V14B_COVERAGE_MAX_COST_USD=0.025
DATAFORSEO_V14B2_MAX_TASKS=2
DATAFORSEO_V14B2_MAX_COST_USD=0.05
DATAFORSEO_V14C2_MAX_TASKS=10
DATAFORSEO_V14C2_MAX_COST_USD=0.15
RAINFOREST_API_KEY=

# Paid calls are opt-in and bounded. Defaults prohibit all paid calls.
RESEARCH_ALLOW_PAID_PROVIDERS=false
RESEARCH_MAX_PAID_CALLS=0
RESEARCH_MAX_COST_USD=0
